      "id": 408,
      "type": "timeseries",
      "title": "Volume par niveau détecté (detected_level)",
      "description": "Niveaux détectés automatiquement par Loki 3 (info/warn/error/...). Si vide : vérifier discover_log_levels dans limits_config.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
