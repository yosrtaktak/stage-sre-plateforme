      "id": 1000,
      "panels": [],
      "title": "📊 Volume & Taux d'erreur (Loki)",
      "type": "row"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "id": 405,
      "type": "stat",
      "title": "Débit total de logs",
      "description": "Lignes de log par seconde sur le namespace sélectionné.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1,
          "unit": "logs/s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": 0
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "refId": "A",
          "expr": "sum(rate({k8s_namespace_name=\"$namespace\", k8s_pod_name=~\"$pod\"} [5m]))",
          "legendFormat": "lignes/s"
        }
      ]
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "id": 406,
      "type": "stat",
      "title": "Lignes d'erreur / s",
      "description": "Lignes contenant error/exception/fatal/panic (insensible à la casse).",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2,
          "unit": "logs/s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "orange",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "refId": "A",
          "expr": "sum(rate({k8s_namespace_name=\"$namespace\", k8s_pod_name=~\"$pod\"} |~ \"(?i)(error|exception|fatal|panic)\" [5m]))",
          "legendFormat": "erreurs/s"
        }
      ]
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "id": 407,
      "type": "stat",
      "title": "% de lignes en erreur",
      "description": "Part des lignes d'erreur dans le volume total (fenêtre 5m).",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2,
          "unit": "percent",
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "refId": "A",
          "expr": "100 * sum(rate({k8s_namespace_name=\"$namespace\", k8s_pod_name=~\"$pod\"} |~ \"(?i)(error|exception|fatal|panic)\" [5m])) / sum(rate({k8s_namespace_name=\"$namespace\", k8s_pod_name=~\"$pod\"} [5m]))",
          "legendFormat": "% erreurs"
        }
      ]
    },
    {
      "datasource": {
