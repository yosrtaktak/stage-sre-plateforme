# This file configures the git settings for this repository.

# Converts "CR + LF" to "LF", for all "text" files — for local files on all OSes and files pushed to the remote repo.
* text=auto eol=lf
*.py   text eol=lf
*.sh   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.sql  text eol=lf
*.md   text eol=lf
*.png  binary
*.jpg  binary
*.pdf  binary
